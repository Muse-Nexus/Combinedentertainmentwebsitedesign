# Server-only Airtable credentials. Never prefix these with VITE_.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# These names match the Raining Entertainment Booking Hub.
AIRTABLE_EVENTS_TABLE=Public Events
AIRTABLE_MOMENTS_TABLE=Moments
AIRTABLE_PACKAGES_TABLE=Casino Packages
AIRTABLE_INQUIRIES_TABLE=Leads / Inquiries

# Backward-compatible table ID for the same Leads / Inquiries table.
AIRTABLE_TABLE_ID=

# Optional Airtable views. Leave blank to query the full table.
AIRTABLE_EVENTS_VIEW=
AIRTABLE_MOMENTS_VIEW=
AIRTABLE_PACKAGES_VIEW=

# Google Analytics 4 web data stream. Set only in the environments that should
# collect data; leave preview unset unless it has a dedicated test stream.
VITE_GOOGLE_ANALYTICS_ID=

# Content value from Search Console's HTML tag verification method. A DNS
# domain-property verification is still preferred for the canonical domain.
VITE_GOOGLE_SITE_VERIFICATION=
